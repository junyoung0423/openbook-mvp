# 복사해서 .env로 만들고 값을 채웁니다. .env는 커밋하지 않습니다.

# Upstage (Solar Pro 4 LLM, Document Parse)
UPSTAGE_API_KEY=

# PostgreSQL
DATABASE_URL=postgresql+psycopg://openbook:openbook@localhost:5432/openbook

# 임베딩 모델 (로컬 실행)
EMBEDDING_MODEL=dragonkue/snowflake-arctic-embed-l-v2.0-ko
CHROMA_DIR=./chroma_db

# 로컬 개발용: 1이면 로그인 없이 "로컬 사용자"로 씁니다. SQLite DB일 때만 동작하고, 배포에서는 넣지 마세요.
# OPENBOOK_AUTH_DISABLED=1

# 화면 주소 (CORS). 여러 개면 쉼표. 배포 안내: docs/deploy-vercel.md
# CORS_ORIGINS=http://localhost:3000

# 1이면 계약서 처리를 요청 안에서 끝낸다 (Vercel에서는 VERCEL=1로 자동)
# OPENBOOK_INLINE_PROCESSING=1

# 법령 근거 Q&A: 법제처 Open API 신청 시 받은 OC 값 (open.law.go.kr)
# LAW_OC=
