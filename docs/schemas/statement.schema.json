{
  "$defs": {
    "StatementDeduction": {
      "description": "정산서에 적힌 공제 한 줄 (예: 앱마켓 수수료). 금액만 받는다.",
      "properties": {
        "name": {
          "description": "정산서에 적힌 공제 항목 이름",
          "title": "Name",
          "type": "string"
        },
        "amount": {
          "description": "원 단위 금액",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "title": "Amount",
          "type": "string"
        }
      },
      "required": [
        "name",
        "amount"
      ],
      "title": "StatementDeduction",
      "type": "object"
    }
  },
  "description": "정산서 한 건 (statements 테이블 한 행). POST /contracts/{id}/statements 요청 본문.",
  "properties": {
    "period_start": {
      "format": "date",
      "title": "Period Start",
      "type": "string"
    },
    "period_end": {
      "format": "date",
      "title": "Period End",
      "type": "string"
    },
    "gross": {
      "description": "정산서 '매출액' (총매출)",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "title": "Gross",
      "type": "string"
    },
    "net_revenue": {
      "anyOf": [
        {
          "description": "원 단위 금액 (음수 가능)",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "정산서 '회사입금액'. 순매출 기준 계약이면 필요",
      "title": "Net Revenue"
    },
    "deductions": {
      "description": "정산서에 적힌 공제 항목. 없으면 빈 목록",
      "items": {
        "$ref": "#/$defs/StatementDeduction"
      },
      "title": "Deductions",
      "type": "array"
    },
    "reported_settlement": {
      "anyOf": [
        {
          "description": "원 단위 금액 (음수 가능)",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "정산서 '정산액' (작가 몫). 있으면 R12로 대조",
      "title": "Reported Settlement"
    },
    "reported_withholding": {
      "anyOf": [
        {
          "description": "원 단위 금액",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "정산서 '원천징수'. 있으면 R11로 대조",
      "title": "Reported Withholding"
    },
    "reported_payout": {
      "description": "정산서 '작가지급액' (원천징수 뒤 실제 받는 돈)",
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "title": "Reported Payout",
      "type": "string"
    }
  },
  "required": [
    "period_start",
    "period_end",
    "gross",
    "reported_payout"
  ],
  "title": "Statement",
  "type": "object"
}
